    "type": "git",
    "url": "git+https://github.com/huangdihd/Differentiable.git"
  },
  "homepage": "https://github.com/huangdihd/Differentiable#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gpu": "node scripts/test-gpu.mjs",
    "benchmark:temporal": "node scripts/generate-temporal-benchmark.mjs",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "build:demo": "npm run build && node scripts/obfuscate.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "javascript-obfuscator": "^4.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.4"
  }
}
